# ============================================
# MRR Website Authentication Server - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!
# ============================================

# --------------------------------------------
# Server Configuration
# --------------------------------------------
# Port number for the server (default: 5000)
PORT=5000

# Environment: development | production | test
# REQUIRED - Must be set explicitly
NODE_ENV=development

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# PostgreSQL connection string
# REQUIRED - Format: postgresql://[username:password@]host[:port]/database
# Local: postgresql://username:password@localhost:5432/mrr_website
# Cloud: postgresql://username:password@host:5432/mrr_website
DATABASE_URL=postgresql://username:password@localhost:5432/mrr_website

# Maximum number of connection retry attempts (default: 5)
DB_MAX_RETRIES=5

# --------------------------------------------
# JWT Configuration
# --------------------------------------------
# Secret key for signing JWT tokens
# REQUIRED - Use a strong random string (min 32 characters)
# Generate: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Access token expiry (default: 24h)
# Format: 1h, 24h, 7d, etc.
JWT_EXPIRY=24h

# Refresh token expiry (default: 7d)
REFRESH_TOKEN_EXPIRY=7d

# --------------------------------------------
# Google OAuth Configuration
# --------------------------------------------
# Get credentials from: https://console.cloud.google.com/apis/credentials
# REQUIRED for Google Sign-In feature
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --------------------------------------------
# Facebook OAuth Configuration
# --------------------------------------------
# Get credentials from: https://developers.facebook.com/apps
# REQUIRED for Facebook Sign-In feature
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_GRAPH_API_VERSION=v18.0

# --------------------------------------------
# Email Service Configuration
# --------------------------------------------
# Email service provider: gmail | sendgrid | ses | smtp
EMAIL_SERVICE=gmail

# SMTP host (for gmail: smtp.gmail.com)
EMAIL_HOST=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
EMAIL_PORT=587

# Email account username
# REQUIRED - For Gmail, use your full email address
EMAIL_USER=your-email@gmail.com

# Email account password
# REQUIRED - For Gmail, use App Password (not your regular password)
# Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your-16-char-app-password

# From email address (shown to recipients)
EMAIL_FROM=MRR Website <noreply@mrrwebsite.com>

# --------------------------------------------
# OTP Configuration
# --------------------------------------------
# OTP expiry time (default: 5m)
# Format: 1m, 5m, 10m, etc.
OTP_EXPIRY=5m

# Cooldown period before resending OTP (default: 30s)
# Format: 30s, 1m, etc.
OTP_RESEND_COOLDOWN=30s

# --------------------------------------------
# Password Security Configuration
# --------------------------------------------
# Bcrypt salt rounds (default: 10)
# Higher = more secure but slower (10-12 recommended)
BCRYPT_SALT_ROUNDS=10

# --------------------------------------------
# Rate Limiting Configuration
# --------------------------------------------
# Time window for rate limiting (default: 15m)
# Format: 1m, 15m, 1h, etc.
RATE_LIMIT_WINDOW=15m

# Maximum requests per window per IP (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# --------------------------------------------
# CORS Configuration
# --------------------------------------------
# Allowed origin for CORS (frontend URL)
# Development: http://localhost:5173
# Production: https://yourdomain.com
# Multiple origins: http://localhost:5173,https://yourdomain.com
CORS_ORIGIN=http://localhost:5173

# ============================================
# PRODUCTION CHECKLIST:
# ============================================
# [ ] Change NODE_ENV to 'production'
# [ ] Use strong JWT_SECRET (min 32 chars)
# [ ] Use production PostgreSQL URI (managed service recommended)
# [ ] Configure real Google OAuth credentials
# [ ] Set up production email service (SendGrid/AWS SES recommended)
# [ ] Update CORS_ORIGIN to production domain
# [ ] Enable HTTPS/SSL
# [ ] Set appropriate rate limits
# [ ] Run: npx prisma migrate deploy
# ============================================
